PROJECT_NAME=TCL WorkHub
ENVIRONMENT=development

# Public URLs
FRONTEND_PUBLIC_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000

# Backend
BACKEND_CORS_ORIGINS=http://localhost:3000
BACKEND_SECRET_KEY=change-me

# Database
POSTGRES_DB=tcl_workhub
POSTGRES_USER=tcl_workhub
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://tcl_workhub:change-me@postgres:5432/tcl_workhub
KEYCLOAK_DB=keycloak

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_REALM=tcl-workhub
KEYCLOAK_BACKEND_CLIENT_ID=tcl-workhub-api
KEYCLOAK_FRONTEND_CLIENT_ID=tcl-workhub-web
KEYCLOAK_PUBLIC_ISSUER_URL=http://localhost:8080/realms/tcl-workhub
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=tcl-workhub
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=tcl-workhub-web
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
